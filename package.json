{
  "name": "fishpond-weekly",
  "productName": "鱼塘周记馆",
  "version": "1.0.0",
  "private": true,
  "description": "鱼塘周记馆 —— 本地复盘 + 灵感素材收纳的养鱼小工具",
  "author": {
    "name": "Fish Pond Studio",
    "email": "hello@fishpond.local"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "icon": "node scripts/gen-icon.js",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:all": "npm run build && electron-builder -mw"
  },
  "dependencies": {
    "lowdb": "^7.0.1",
    "pinia": "^2.2.6",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.8"
  },
  "build": {
    "appId": "com.fishpond.weekly",
    "productName": "鱼塘周记馆",
    "copyright": "Copyright © 2026 鱼塘周记馆",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/lowdb/**",
      "node_modules/steno/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "鱼塘周记馆-${version}-安装包.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "鱼塘周记馆",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "artifactName": "鱼塘周记馆-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "鱼塘周记馆 ${version}"
    }
  }
}
